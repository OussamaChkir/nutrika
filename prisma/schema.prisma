generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ============================================
// AUTH.JS MODELS
// ============================================

model User {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  image          String?
  passwordHash   String?
  role           UserRole  @default(USER)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Health profile
  weight         Float?            // kg
  height         Float?            // cm
  dateOfBirth    DateTime?
  allergies      String[]          // e.g. ["gluten", "lactose"]

  accounts       Account[]
  sessions       Session[]
  products       Product[]          @relation("CreatedProducts")
  contributions  Contribution[]     @relation("UserContributions")
  reviews        Contribution[]     @relation("ReviewedContributions")
  scanHistory    ScanHistory[]
  feedbacks      ProductFeedback[]
  favorites      Favorite[]
  profiles       Profile[]
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================
// APP MODELS
// ============================================

model Product {
  id               String            @id @default(auto()) @map("_id") @db.ObjectId
  barcode          String            @unique
  name             String
  brand            String?
  imageUrl         String?
  
  // Cached Open Food Facts data
  offData          Json?
  
  // Calculated scores
  score            Int               @default(0) // 0-100
  scoreLetter      ScoreLetter       @default(C)
  scoreColor       String            @default("#f97316") // Orange
  
  // Analysis
  positives        Json[]            // Array of { text: string, icon?: string }
  negatives        Json[]            // Array of { text: string, icon?: string }
  allergens        String[]
  allergensSeverity AllergenSeverity @default(LOW)
  dietaryTags      String[]          @default([])
  
  // Nutrition (per 100g)
  energy           Float?            // kJ or kcal
  fat              Float?
  saturatedFat     Float?
  carbohydrates    Float?
  sugars           Float?
  fiber            Float?
  proteins         Float?
  salt             Float?
  
  // Manufacturing / Processing
  manufacturingPlaces String?
  origins            String?
  
  // Status
  status           ProductStatus     @default(DRAFT)
  createdById      String?           @db.ObjectId
  createdBy        User?             @relation("CreatedProducts", fields: [createdById], references: [id])
  approvedAt       DateTime?
  
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  
  contributions    Contribution[]
  scanHistory      ScanHistory[]
  feedbacks        ProductFeedback[]
  favorites        Favorite[]
  explanations     ProductExplanation[]
}

model Contribution {
  id           String             @id @default(auto()) @map("_id") @db.ObjectId
  
  productId    String             @db.ObjectId
  product      Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  userId       String             @db.ObjectId
  user         User               @relation("UserContributions", fields: [userId], references: [id])
  
  // Proposed changes as JSON
  changes      Json
  reason       String?            // User's explanation for the edit
  
  status       ContributionStatus @default(PENDING)
  
  reviewedById String?            @db.ObjectId
  reviewedBy   User?              @relation("ReviewedContributions", fields: [reviewedById], references: [id])
  reviewNote   String?
  reviewedAt   DateTime?
  
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

// ============================================
// SCAN HISTORY
// ============================================

model ScanHistory {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String   @db.ObjectId
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  scannedAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId, scannedAt])
}

// ============================================
// PRODUCT FEEDBACK (PREMIUM ONLY)
// ============================================

model ProductFeedback {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String   @db.ObjectId
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating    Int                 // 1-5
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
}

// ============================================
// FAVORITES
// ============================================

model Favorite {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String   @db.ObjectId
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

// ============================================
// AI SCORE EXPLANATIONS (cache for the nutrika-ai service)
// ============================================
// Not user-specific: the same explanation is shown to everyone for a given
// product, language and prompt version. Fallback (non-LLM) answers are never stored.

model ProductExplanation {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  productId     String   @db.ObjectId
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  locale        String                 // "en" | "fr"
  promptVersion String                 // e.g. "explain-v1", returned by the AI service
  score         Int                    // product score when generated; a changed score makes this stale
  summary       String
  highlights    Json                   // Array of { topic, detail, tone }
  swapTip       String?
  model         String?                // LLM that wrote it, for traceability
  createdAt     DateTime @default(now())

  @@unique([productId, locale, promptVersion])
}

// ============================================
// PERSONAL PROFILES (F1 personal score, F7 allergen strictness, F4 family)
// ============================================
// Many per user from day one, so family profiles need no migration.
// Values are validated by lib/profiles/constants.ts (profileInputSchema).
// Health data: only stored after an explicit consent (consentedAt), and deleted with the profile
// or with the account (onDelete: Cascade). Nickname + age band, never a full name or birth date.

model Profile {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  userId             String   @db.ObjectId
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String                       // nickname
  ageBand            String   @default("adult")   // child | teen | adult
  isDefault          Boolean  @default(false)
  conditions         String[]                     // diabetes | hypertension
  diets              String[]                     // vegan | vegetarian | keto | low_sodium
  goals              String[]                     // weight_loss | muscle_gain
  allergens          String[]                     // labels from lib/allergens.ts, same as User.allergies
  allergenStrictness String   @default("avoid_traces") // avoid_traces | intentional_only
  consentedAt        DateTime
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([userId])
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  USER
  PREMIUM
  ADMIN
}

enum ProductStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum ContributionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ScoreLetter {
  A
  B
  C
  D
  E
}

enum AllergenSeverity {
  LOW
  MEDIUM
  HIGH
}
