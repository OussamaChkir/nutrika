# --- Database (MongoDB, used by Prisma) ---
DATABASE_URL="mongodb+srv://USER:PASSWORD@cluster.mongodb.net/nutrika"

# --- Auth.js ---
# Generate with: npx auth secret
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Vercel Blob (image uploads) ---
BLOB_READ_WRITE_TOKEN=""

# --- AI service (nutrika-ai, FastAPI). Server-side only, never prefix with NEXT_PUBLIC_ ---
NUTRIKA_AI_URL="http://localhost:8000"
NUTRIKA_AI_KEY=""

# --- Feature flags (all off by default; accepted "on" values: 1, true, on, yes) ---
# NEXT_PUBLIC_* so they work on server and client. Changing one needs a redeploy.
NEXT_PUBLIC_FF_PERSONAL_SCORE=""
NEXT_PUBLIC_FF_FAMILY_PROFILES=""
NEXT_PUBLIC_FF_INGREDIENT_EXPLANATIONS=""
NEXT_PUBLIC_FF_MAY_CONTAIN_MODE=""
NEXT_PUBLIC_FF_ALTERNATIVES=""
# F2: optional Open Food Facts country tag searched first for alternatives, e.g. en:tunisia
ALTERNATIVES_COUNTRY=""
NEXT_PUBLIC_FF_SHOPPING_LIST=""
NEXT_PUBLIC_FF_SCAN_INSIGHTS=""
NEXT_PUBLIC_FF_OFFLINE_MODE=""
NEXT_PUBLIC_FF_LABEL_SCAN=""
NEXT_PUBLIC_FF_MENU_MODE=""

# --- F5 label photo scanning (Google Gemini API). Server-side only, never NEXT_PUBLIC_ ---
# Get a key in Google AI Studio. Model names change over time: set the current one yourself,
# for example a "flash-lite" model, and check its free limits in AI Studio.
GEMINI_API_KEY=""
GEMINI_MODEL=""
# "free" (default): free tier. Google may use photos to improve its products and people may read
# them, and Google only allows PAID services for users in the EEA, Switzerland and the UK, so
# photo scanning is blocked in those regions (and when the country is unknown).
# "paid": set ONLY after enabling billing on the Google Cloud project behind the key. Opens it everywhere.
GEMINI_TIER="free"
# Total photo scans per rolling 24 hours across all users (default 200). Keep under your quota.
GEMINI_DAILY_BUDGET="200"
